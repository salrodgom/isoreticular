# Temporary file used to convert an opes KERNELS file into a STATE file
# vim:ft=plumed
UNITS NATURAL
RESTART
f: FIXEDATOM AT=0,0,0
d: DISTANCE ATOMS=f,f
COMMITTOR ARG=d BASIN_LL1=-1 BASIN_UL1=1
delta: COMBINE ARG=d PERIODIC=NO
cell: COMBINE ARG=d PERIODIC=NO
opes: OPES_METAD_EXPLORE ARG=delta,cell FILE=../WT-MetaMD_13000bar_MultiWalker_MultiState/KERNELS STATE_WFILE=COSA BIASFACTOR=20.16977402952219 EPSILON=0.3491807942515971 KERNEL_CUTOFF=6.351342224998144 COMPRESSION_THRESHOLD=1 TEMP=1 PACE=1 BARRIER=1 SIGMA=1,1