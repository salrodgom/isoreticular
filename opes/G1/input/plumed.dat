# Use energy, volume and Delta as CVs 
energy: ENERGY
volume: VOLUME
#
d1_1: DISTANCE ATOMS=80,361
d1_2: DISTANCE ATOMS=639,931
d1: MATHEVAL ARG=d1_1,d1_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
d2_1: DISTANCE ATOMS=199,914
d2_2: DISTANCE ATOMS=379,807
d2: MATHEVAL ARG=d2_1,d2_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
d3_1: DISTANCE ATOMS=205,634
d3_2: DISTANCE ATOMS=377,525
d3: MATHEVAL ARG=d3_1,d3_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
d4_1: DISTANCE ATOMS=51,485
d4_2: DISTANCE ATOMS=659,1104
d4: MATHEVAL ARG=d4_1,d4_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
d5_1: DISTANCE ATOMS=349,490
d5_2: DISTANCE ATOMS=233,669
d5: MATHEVAL ARG=d5_1,d5_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
d6_1: DISTANCE ATOMS=651,941
d6_2: DISTANCE ATOMS=60,359
d6: MATHEVAL ARG=d6_1,d6_2 FUNC=0.5*sqrt((x-y)*(x-y)) PERIODIC=NO
#
delta: MATHEVAL ARG=d1,d2,d3,d4,d5,d6 VAR=x1,x2,x3,x4,x5,x6 FUNC=10*(x1+x2+x3+x4+x5+x6)/6.0 PERIODIC=NO     # delta  in A
cell: MATHEVAL ARG=volume FUNC=10.0*(x/8.0)^(1.0/3.0) PERIODIC=NO  # volume in A
#
# Construct bias potential with OPS
mtp: ECV_MULTITHERMAL_MULTIBARIC ...
   ARG=energy,volume
   PRESSURE=0.06022140857*8000        #     1.0   GPa = 10 kbar
   TEMP=298.15                        #   300.0   K
   PRESSURE_MIN=0.06022140857*1       #    1 bar
   PRESSURE_MAX=0.06022140857*18000   #    
   TEMP_MIN=250.0 TEMP_MAX=350.0
...
umb: ECV_UMBRELLAS_LINE ARG=delta CV_MIN=0.0 CV_MAX=3.0 SIGMA=0.1 TEMP=298.15
opes: OPES_EXPANDED ARG=mtp.*,umb.* FILE=DeltaFs.data PACE=500 WALKERS_MPI
bias: COMBINE ARG=*.bias PERIODIC=NO 
#
PRINT STRIDE=10 ARG=energy,volume,delta,cell,mtp.*,umb.*,bias FILE=COLVARS   
FLUSH STRIDE=10

ENDPLUMED
